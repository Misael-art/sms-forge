  "findings": [
    {
      "id": "R1",
      "priority": "P1",
      "file": "tools/sms_wrapper/artifact_registry.py",
      "lines": [
        110,
        120
      ],
      "title": "Canonical destination aliases are accepted",
      "reproduction": "reproduce.py case location_alias: add location alias -> existing data/source_art. audit returns ok:true.",
      "cause": "inside validates resolved root confinement but returns lexical path; overlapping location checks compare lexical p/q.",
      "required_change": "Compare resolved locations for equality/ancestry and make destination containment use resolved paths. For reserved outputs resolve existing ancestors before checking."
    },
    {
      "id": "R2",
      "priority": "P1",
      "file": "tools/sms_wrapper/artifact_registry.py",
      "lines": [
        166,
        179
      ],
      "title": "File bypasses its kind destination through project-internal symlink",
      "reproduction": "reproduce.py case file_destination_escape: data/source_art/foreign -> elsewhere, file is elsewhere/image.png but registered as source_art/foreign/image.png. audit returns ok:true.",
      "cause": "p.is_relative_to(location) is lexical; inside only confines to whole project.",
      "required_change": "Check p.resolve() belongs to location.resolve(), including canonical parent chain of reserved output. Preserve legitimate symlinks only when resolved target remains in declared destination."
    },
    {
      "id": "R3",
      "priority": "P1",
      "file": "tools/sms_wrapper/artifact_registry.py",
      "lines": [
        176,
        179
      ],
      "title": "Two artifacts can own the same inode via hardlinks",
      "reproduction": "reproduce.py case hardlink_ownership: distinct paths and different artifact kind/asset IDs hardlinked to same source. audit returns ok:true; os.path.samefile true.",
      "cause": "ownership keyed only by p.resolve() distinguishes hardlink aliases.",
      "required_change": "For sealed files track (st_dev,st_ino), or samefile, alongside resolved path; reject shared physical file ownership and require parent/role reference instead. Also check legacy ownership by inode."
    },
    {
      "id": "R4",
      "priority": "P2",
      "file": "tools/sms_wrapper/harness_orchestration.py",
      "lines": [
        47,
        54
      ],
      "title": "Malformed falsy tasks and IDs become valid plans",
      "reproduction": "reproduce.py malformed_tasks_{} /False/0/empty-string all ok:true; malformed_ID_0 /False/[]/{} become t0 and worker.",
      "cause": "tasks = get(...) or [] and id = get(...) or fallback discard invalid explicit types before validation.",
      "required_change": "Apply defaults only if field omitted; explicit tasks must list and provided ID must nonempty string, then enforce uniqueness."
    }
  ],
