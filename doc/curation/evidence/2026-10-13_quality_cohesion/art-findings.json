    {
      "id": "A01",
      "classification": "extend_L124_no_duplicate_id",
      "title": "Autorização de edição por revisão substitui proibição genérica",
      "evidence": "Feedback v07 proibiu scripts; emenda v08 autorizou máscaras intramaterial; v08.2 autorizou cruzar fronteiras de material/contorno preservando alpha. L124 follow_up ainda afirma scripts_may_measure_or_highlight_but_may_not_write_art_pixels=true.",
      "action": "L124/art-review/sms-pixel-translate: default diagnosticar sem mutação; edição só com contrato vigente e autorização explícita de operador, máscara, alvos, fronteiras, invariantes, empates, limite de iteração, delta; registrar emenda supersedendo restrição específica. Não canonizar ImageGen proibido para toda criação autoral."
    },
    {
      "id": "A02",
      "classification": "extend_L124",
      "title": "Máscara exportada não equivale a semântica validada",
      "evidence": "v08.1 report cabelo máscara61/61 zero não cinza; houve recuperação de1014 pixels da franja vermelha. Máscaras geradas heuristicamente usam anchors/halo65%, não anotação humana autenticada.",
      "action": "Revisar mask overlay e cobertura das fronteiras no fonte antes de aceitar zero vazamentos; separar mask_origin=heuristic/manual, revisão, SHA e delta de ownership. Zero dentro máscara cobre somente região classificada."
    },
    {
      "id": "A03",
      "classification": "new_measurable_detail_under_L124",
      "title": "Bloco sólido2×2 é predicado distinto de área/bbox",
      "evidence": "v08.1 usa area>=4 e bbox>=2x2, resta102/139/553 componentes; v08.2 small_cluster_components testa quatro vizinhos do quadrado com AND.",
      "action": "Gate diagnóstico genérico deve declarar connectivity, criterion=contains_solid_square e tamanho por material; negativos L/diagonal/linha.2×2 é diretriz deste asset, não mínimo universal. Exceções nomeadas haste1px/olhos/óculos precisam máscara/papel/autorização."
    },
    {
      "id": "A04",
      "classification": "new_algorithm_detail_under_L124",
      "title": "Convergência e limite não provam qualidade artística",
      "evidence": "Candidato cita oscillação em snapshot; código v08.2 processa um componente,recalcula,limita10000; report registraiterations per61frames,sem limite atingido.",
      "action": "Documentar one-at-time/recompute/cap/no-neighbor/tie policy; diagnóstico deve confirmar fixed-point e unresolved sem pintar. Algoritmo estabilizado não prova iluminação/anatomia; não reutilizar thresholds heurísticos como receita universal."
    },
    {
      "id": "A05",
      "classification": "extend_L124",
      "title": "Alpha preservado não significa contorno/material preservados",
      "evidence": "Reportv08.2 alpha0delta/original_outline_modified0, mas863 novos pixels índicecontorno e23236 RGBalterados com transferências entre materiais.",
      "action": "Delta separa alpha, contorno original removido/recolorido, contorno acrescentado, ownershiptransfer, rampachanges e coordenadas porframe. Não reportar geometry_same como garantia da silhueta interna ou semântica."
    },
