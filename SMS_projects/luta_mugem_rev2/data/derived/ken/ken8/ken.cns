; WIN
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time= 0
v = 1
range = 0,100

[State 180, 2]
type = ChangeState
trigger1 = command = "hold_a"
trigger2 = command = "hold_x"
value =181

[State 180, 2]
type = ChangeState
trigger1 = time= 3
trigger1 = Var(1) = [0,50]
value =181

[State 180, 3]
type = ChangeState
trigger1 = command = "hold_b"
trigger2 = command = "hold_y"
value =182

[State 180, 3]
type = ChangeState
trigger1 = time= 3
trigger1 = Var(1) = [51,100]
value =182

[State 180, 4]
type = Null;ChangeState
trigger1 = command = "hold_c"
trigger2 = command = "hold_z"
value = 183

[State 180, 4]
type = Null;ChangeState
trigger1 = time= 3
trigger1 = Var(1) = [81,100]
value = 183

