;Dash
[Statedef 100]
type = S;Running is on the ground
physics = N;We'll define our own physics
anim = 100;Anim action 100
ctrl = 0;No control for duration of dash

[State 100, 1];To start dashing forwards
type = VelSet
trigger1 = Time= [0,5]
x = 11

[State 100, 2];Friction after initial dash
type = VelMul
trigger1 = Time> 5
x =.85

[State 100, 3];
type = ChangeState
trigger1 = AnimTime= 0
value =0
ctrl = 1

[State 100, 4]
type = PlayerPush
trigger1 = Time>= 0
value = 0

[State 100, 5]
type = AfterImage
trigger1 = Time= 1
time= 25

