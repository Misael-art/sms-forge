;リュウ　基本設定・通常技用ｃｎｓ
;---------------------------------------
;Var(56)　地上受け身

;=======================================
;基本能力値
;========================================
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 51
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 128
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 20
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -70
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.0
walk.back = -2.0
jump.neu = 0,-9.2
jump.back = -3.5
jump.fwd = 3.0

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .4
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
;時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
;勝ちポーズ分岐
[Statedef 180]
type = S

;vs Ken 真空波動勝ち抜け
[State 180, 0]
type = ChangeState
trigger1 = Var(11) = 1 && MatchOver = 1
value = 185

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 10
range = 3

[State 180, 1]
type = ChangeState
trigger1 = 1
trigger1 = var(10) = 0 && PalNo = [1,6]
value = 181

[State 180, 2]
type = ChangeState
trigger1 = 1
trigger1 = var(10) = 1
value = 182

[State 180, 3]
type = ChangeState
trigger1 = 1
trigger1 = var(10) = 2
value = 183

[State 180, 1]
type = ChangeState
trigger1 = 1
trigger1 = var(10) = 3
trigger2 = var(10) = 0 && PalNo = [7,12]
value = 184

