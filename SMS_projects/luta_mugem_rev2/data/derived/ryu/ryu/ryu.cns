;--------------
;vs Ken
[Statedef 185]
type = S
movetype = A
physics = N
anim = 20

[State 185, 1]
type = VelSet
trigger1 = Time = 0
X = const(velocity.walk.fwd.x)

[State 185, 2]
type = VelSet
trigger1 = Abs(ScreenPos X - EnemyNear,ScreenPos X) < 73
X = 0

[State 185, 3]
type = PosAdd
trigger1 = Anim = 185 && AnimElem = 1
X = 73 - ( EnemyNear,ScreenPos X - ScreenPos X)

[State 185, 4]
type = ChangeAnim
trigger1 = Vel X = 0 && Anim != 185
value = 185

;---------------------------------------------------------------------------
;イントロ
[Statedef 191]
type = A
movetype = I
physics = N

[State 191, 8]
type = ChangeState
triggerall = EnemyNear,NumPartner = 0 && NumPartner = 0 && PalNo = [1,6]
trigger1 = Time = 1 && P2Name = "Ken by M.M.R." 
value = 193

[State 191, 8]
type = ChangeState
triggerall = EnemyNear,NumPartner = 0 && NumPartner = 0 && PalNo = [7,12]
trigger1 = Time = 1 && P2Name = "Gouki by M.M.R."
value = 10193

[State 191, 9]
type = ChangeState
trigger1 = Time = 1
value = 192

