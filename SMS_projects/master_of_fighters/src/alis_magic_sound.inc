                                         0xdb,0xfc,0x38,0xdf,0xff,0};
#endif
#ifdef MOF_ALIS_CHOREOGRAPHY
/* Original PSG recovery cues. HP is a rising arpeggio with a soft tail.
   MP answers its first note an octave above, then fades. */
static const uint8_t magic_rest_cue[]={0xc4,0x4d,0xd5,0x39,0xca,0x4a,0x39,
    0xc2,0x49,0x39,0xca,0x46,0xd6,0x3a,0xd9,0x38,0xdc,0x38,0xdf,0xff,0};
#else
static const uint8_t magic_rest_cue[]={0xc2,0x4a,0xd6,0x39,0xc5,0x47,0xd5,0x39,0xc1,0x44,0xd8,0x3a,0xdf,0xff,0};
#endif
static const uint8_t magic_wing_cue[]={0xe5,0xf5,0xc4,0x52,0xd7,0x39,0xfb,0xc1,0x47,0x39,0xe4,0xf5,0x39,0xfc,0x39,0xdf,0xff,0};

#ifdef MOF_ALIS_FEEDBACK
#include "../inc/alis_feedback.h"
#ifdef MOF_ALIS_CHOREOGRAPHY
static const uint8_t magic_mp_cue[]={0xc8,0x46,0xd5,0x39,0xdb,0x38,0xc4,0x43,
    0xd5,0x39,0xc1,0x43,0xd8,0x38,0xdb,0x39,0xdf,0xff,0};
#else
static const uint8_t magic_mp_cue[]={0xcf,0x42,0xd5,0x39,0xc2,0x46,0xd7,0x38,0xcb,0x42,0xd7,0x3a,0xdf,0xff,0};
#endif
#endif

void mof_magic_sound(void)
{
    uint8_t event=mof_magic.audio;
    const uint8_t *cue=mof_sfx_special;
#ifdef MOF_ALIS_FEEDBACK
    if (event==MOF_SFX_HP) cue=magic_rest_cue;
    else if (event==MOF_SFX_MP) cue=magic_mp_cue;
    else
#endif
#ifdef MOF_ALIS_COMBAT
    if (event==MOF_SFX_LANDING) cue=magic_landing_cue;
    else
#endif
    if (event==REST || event==CHAT || event==STUN) cue=magic_rest_cue;
    else if (event==MYAU) cue=magic_wing_cue;
    else if (event==MIRROR) cue=mof_sfx_guard;
    else if (event==SLASH || event==SABER) cue=mof_sfx_blade_hit;
    else if (event==GUARDIANS) cue=mof_sfx_palma;
    mof_magic.audio=0;
    PSGSFXPlay((void *)cue,SFX_CHANNELS2AND3);
}
