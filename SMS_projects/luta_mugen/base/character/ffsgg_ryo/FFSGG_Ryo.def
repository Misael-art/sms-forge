

;--------------------------------------------------------
[Info]
name           = "FFSGG_Ryo"
displayname    = "FFSGG Ryo"
versiondate    = 07.19.26
ikemenversion    =  Nightly  ;(must be always added to stages with 1.1 specific features enabled ie zoom added)
author           = "Vegaz Parelli/Lightflare"
round1def = stages/FFSGG_Ryo_Dawn.def
round2def = stages/FFSGG_Ryo_Night.def

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -60
boundright = 60
boundhigh = 0
boundlow    = 0
tension    = 80
;tensionhigh  = 180               (adjust height accordingly to stage sprite max scroll height)
;tensionlow   = 60
verticalfollow    = .95        (Deprecated: Only use if stage is for Winmugen/1.0 only and no 1.1 specific features in use ie zoom)
floortension    = 30       (Deprecated: Only use if stage is for Winmugen/1.0 only and no 1.1 specific features in use ie zoom)
;overdrawhigh    = 120       (required for 1.1 compatibility)
;overdrawlow    = 120       (required for 1.1 compatibility)
;cuthigh    = 0                  (required for 1.1 compatibility)
;cutlow       = 0                   (required for 1.1 compatibility)
;startzoom    = 1                  (should always be set to 1: higher/lower values can cause character specific errors)
;zoomin       = 1                  (should always be set to 1: higher/lower values can cause character specific errors)
;zoomout    = .75                (set to optional value according to new stage sprite bound values)

;--------------------------------------------------------
[PlayerInfo]
p1startx    = -25
p1starty    = 0
p1facing    = 1
p2startx    = 25
p2starty    = 0
p2facing    = -1
p3startx    = -40
p3starty    = 0
p3facing    = 1
p4startx    = 40
p4starty    = 0
p4facing    = -1

;--- Common ---
leftbound  = -1000 
rightbound =  1000 
topbound  =  0     
botbound  =  0     

;--------------------------------------------------------
[Scaling]
topz     = 0       
botz     = 50      
topscale = 1      
botscale = 1.2  

;--------------------------------------------------------
[Bound]
screenleft = 5   
screenright = 5   
;--------------------------------------------------------
[StageInfo]
zoffset = 107
autoturn = 1
resetBG = 0
localcoord    = 160,120
xscale       = 1
yscale       = 1

[Shadow]
color = 0,0,0
yscale = .1
reflect = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/FFSGG_Ryo.mp3
bgmvolume = 255

;========================================================

[BGdef]
spr = stages/FFSGG_Ryo_Dawn.sff
debugbg = 0


[BG back]
type 		= anim
actionno 	= 1
start 		= 0, 120
delta 		= .8,1
mask 		= 0

[BG floor]
type 		= parallax
spriteno 	= 0,0
start 		= 0, 120
delta 		= .8000,1
width		= 256,384
mask 		= 0

[begin action 1]
1,0, 0,0, 10
1,1, 0,0, 10
1,2, 0,0, 10