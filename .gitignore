# SMSForge — .gitignore
# Exclui toolchain binária, emuladores, artefatos de build e caches.
# O repo guarda CÓDIGO, DOCUMENTAÇÃO e FRAMEWORK, não binários/toolchain.

# toolchain (binária grande, instalar via ensure_toolchain.sh)
sdk/sdcc-portable/
sdk/devkitSMS-upstream/
sdk/devkitSMS/
sdk/env.sh

# emuladores (binários grandes; registrar conteúdo via README)
tools/emuladores/
tools/ai_imagegen/

# artefatos de build / ROMs versionadas / saídas
SMS_projects/*/out/
SMS_projects/*/changelog/roms/
# Continuidade: o histórico de ROMs do openbor é evidência do cap5, não lixo.
!SMS_projects/openbor_sms_rev1/changelog/roms/
!SMS_projects/openbor_sms_rev1/changelog/roms/**
SMS_Engines/*/build/
SMS_Engines/*/*.sms
SMS_projects/*/main.asm
SMS_projects/*/main.lst
SMS_projects/*/main.sym
SMS_projects/*/*.rel
SMS_projects/*/*.ihx

# pngs de evidencia/referencia (nao sao assets de jogo; as provas ficam no out/ local)
SMS_projects/*/doc/tela_funcional_referencia.png
SMS_Engines/*/proto_engine_screenshot.png
SMS_Engines/*/*screenshot*.png
doc/tela_funcional_referencia.png

# artefatos de compilacao
**/*.rel
**/*.ihx
**/*.asm
**/*.lst
**/*.sym
**/*.map
**/*.noi
**/*.lk
**/*.bin
# O bank O3 é gerado, mas o build o consome; 80 KiB exatos precisam sobreviver.
!SMS_projects/openbor_sms_rev1/res/o3/banks/o3_pose_blocks_20261017.bin

# python
__pycache__/
*.pyc

# memoria / hooks locais (nao versionar segredos de sessao se houver)
.ai-memory.toml
*.local

# temporario
tmp/

# ---------------------------------------------------------------------------
# Adicionado 2026-09-07 — lacunas medidas com:
#   git ls-files --others --exclude-standard | xargs du -b
# Cobre ~328 MB que estavam a um `git add -A` de entrar na historia.
# NAO cobre codigo/arte de projeto: art_src_base/, rascunho/ e res/ seguem
# versionados, que e a convencao ja vigente no MSSF2T.
# ---------------------------------------------------------------------------

# estado de sessao de ferramentas (efemero, nao e fonte)
# .mimosa/hook-state sozinho tem 279 MB em 4102 arquivos sess_*.baseline
.mimosa/
.zcode/

# dependencias vendorizadas — mesma classe do sdk/devkitSMS/ ja ignorado acima,
# so que noutro diretorio. devkitSMS traz ate um .git proprio aninhado (7,3 MB
# de pack objects), que o git nao versionaria direito de todo jeito.
SMS_Engines/devkitSMS/
SMS_Engines/smslib/

# Projeto aposentado em 2026-10-18; copia local preservada fora do versionamento.
/SMS_projects/hamoopig/

# Checkout-local host bootstrap and restored diagnostic snapshots (2026-10-24)
/out/host-bootstrap/
/out/handoff-*/
